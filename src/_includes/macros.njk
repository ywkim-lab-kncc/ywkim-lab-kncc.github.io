{%- macro trackLabel(track) -%}
{%- if track == "dry" %}Dry lab{% elif track == "wet" %}Wet lab{% else %}Dry + wet lab{% endif -%}
{%- endmacro -%}

{%- macro trackBadge(track) -%}
<span class="track track-{{ track or 'both' }}">{{ trackLabel(track) }}</span>
{%- endmacro -%}

{%- macro avatar(person, cls="") -%}
{%- if person.photo -%}
<img class="avatar {{ cls }}" src="assets/img/people/{{ person.photo }}" alt="" loading="lazy" width="240" height="240">
{%- else -%}
<span class="avatar avatar-initials {{ cls }}" aria-hidden="true">{{ person.name | initials }}</span>
{%- endif -%}
{%- endmacro -%}

{%- macro pubItem(p, labNames) -%}
<li class="pub" data-search="{{ p | searchText(labNames) }}" data-selected="{{ 'true' if p.selected else 'false' }}">
  <p class="pub-title">
    {%- if p.doi %}<a href="https://doi.org/{{ p.doi }}" rel="noopener">{{ p.title }}</a>
    {%- elif p.pmid %}<a href="https://pubmed.ncbi.nlm.nih.gov/{{ p.pmid }}/" rel="noopener">{{ p.title }}</a>
    {%- else %}{{ p.title }}{% endif -%}
  </p>
  <p class="pub-authors">{{ p.authors | authorList(labNames, p.year, p.unbold) | safe }}</p>
  <p class="pub-venue">
    <em>{{ p.journal }}</em> {{ p.year }}{% if p.volume %}; {{ p.volume }}{% endif %}{% if p.pages %}: {{ p.pages }}{% endif %}
    {%- if p.type and p.type != "article" %} <span class="pub-type">{{ p.type }}</span>{% endif %}
    {%- if p.note %} <span class="pub-note">{{ p.note }}</span>{% endif %}
  </p>
  {%- if p.pmid or p.doi or p.code or p.data or p.pdf %}
  <p class="pub-links">
    {%- if p.pmid %}<a href="https://pubmed.ncbi.nlm.nih.gov/{{ p.pmid }}/" rel="noopener">PubMed</a>{% endif %}
    {%- if p.doi %}<a href="https://doi.org/{{ p.doi }}" rel="noopener">DOI</a>{% endif %}
    {%- if p.pdf %}<a href="{{ p.pdf }}" rel="noopener">PDF</a>{% endif %}
    {%- if p.code %}<a href="{{ p.code }}" rel="noopener">Code</a>{% endif %}
    {%- if p.data %}<a href="{{ p.data }}" rel="noopener">Data</a>{% endif %}
  </p>
  {%- endif %}
</li>
{%- endmacro -%}
