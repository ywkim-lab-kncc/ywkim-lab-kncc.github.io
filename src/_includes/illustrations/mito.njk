{#- A mitochondrion: mtDNA rings turn inside, ATP leaves the organelle. -#}
<svg class="illus illus-mito" viewBox="0 0 320 200" role="img" aria-label="Animation: a mitochondrion with circular mitochondrial DNA inside, releasing energy molecules.">
  <rect class="il-outer" x="34" y="44" width="252" height="112" rx="56"/>
  <rect class="il-inner" x="44" y="54" width="232" height="92" rx="46"/>
  <g class="il-cristae">
    <rect x="72" y="50" width="12" height="44" rx="6"/><rect x="96" y="104" width="12" height="46" rx="6"/>
    <rect x="120" y="50" width="12" height="36" rx="6"/><rect x="190" y="112" width="12" height="38" rx="6"/>
    <rect x="214" y="50" width="12" height="42" rx="6"/><rect x="238" y="106" width="12" height="44" rx="6"/>
  </g>
  <g class="il-mtdna" style="transform-origin:150px 96px">
    <circle cx="150" cy="96" r="15" pathLength="100"/>
  </g>
  <g class="il-mtdna il-mtdna-2" style="transform-origin:176px 114px">
    <circle cx="176" cy="114" r="10" pathLength="100"/>
  </g>
  {%- for p in illus.mito.particles %}
  <circle class="il-atp" cx="{{ p.x }}" cy="{{ p.y }}" r="3.5" style="--i:{{ p.i }}; --dx:{{ p.dx }}px; --dy:{{ p.dy }}px"/>
  {%- endfor %}
  <text class="il-text" x="160" y="192" text-anchor="middle">circular mtDNA, 16,569 bp</text>
</svg>
