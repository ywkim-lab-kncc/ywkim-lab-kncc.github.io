---
layout: base.njk
title: Join us
permalink: join.html
---
<div class="page-head">
  <div class="wrap">
    <h1>Join us</h1>
    <p class="lede">{{ join.intro }}</p>
  </div>
</div>

<section class="section section-flush">
  <div class="wrap two-col">
    <div>
      <h2>Open positions</h2>
      <ul class="positions">
        {%- for p in join.positions %}{% if p.open %}
        <li>
          <h3>{{ p.title }}</h3>
          <p>{{ p.text }}</p>
        </li>
        {%- endif %}{% endfor %}
      </ul>
      <h2>How to apply</h2>
      <p>{{ join.how_to_apply }}</p>
    </div>
    <div class="contact-card">
      <h2>Contact</h2>
      <address>
        {{ members.pi.name }}<br>
        {%- if site.contact.office %}{{ site.contact.office }}<br>{% endif %}
        {%- for line in site.contact.address %}{{ line }}<br>{% endfor %}
      </address>
      <p class="email-row"><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a><button type="button" class="copy-btn" data-copy="{{ site.contact.email }}" aria-label="Copy email address" title="Copy email address"><svg class="copy-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg><svg class="check-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span class="copy-msg" aria-live="polite"></span></button></p>
      {%- if site.contact.phone %}<p>{{ site.contact.phone }}</p>{% endif %}
      <p><a href="{{ site.contact.map_url }}" rel="noopener">Open in Google Maps</a></p>
    </div>
  </div>
</section>
